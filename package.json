{
	"name": "diplomacy",
	"version": "0.0.1",
	"description": "App web tudo em um para simulações da ONU (MUNs), começando pelo UFRGSMUN",
	"homepage": "https://diplomacy.rafesilvadesouza.workers.dev",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker --noEmit",
		"tamanho": "node scripts/tamanho.js",
		"db:iniciar": "supabase start -x studio,imgproxy,logflare,vector,postgres-meta,mailpit,supavisor",
		"db:resetar": "supabase db reset",
		"db:tipos": "supabase gen types typescript --local > src/lib/database.types.ts",
		"seed": "node scripts/seed.ts",
		"demo": "node scripts/demonstracao.ts",
		"test:db": "supabase test db",
		"test:unit": "vitest run",
		"textos": "node scripts/textos-fixos.ts",
		"test:e2e": "playwright test",
		"testar:mudou": "node scripts/testar-mudou.ts",
		"capturas": "sh scripts/capturas.sh",
		"rapido": "npm run check && npm run textos && npm run test:unit",
		"testar": "npm run check && npm run textos && npm run test:unit && npm run test:db && npm run build && npm run tamanho && npm run test:e2e"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"fake-indexeddb": "6.0.0",
		"supabase": "^3.2.0",
		"svelte": "^5.59.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@fontsource/spectral": "^5.3.0",
		"@lucide/svelte": "^1.77.0",
		"@supabase/supabase-js": "^2.119.2",
		"flag-icons": "^7.6.0",
		"idb-keyval": "6.2.1",
		"qrcode-generator": "1.4.4"
	}
}
