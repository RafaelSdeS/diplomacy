# Copie para .env. Estes são os valores padrão do Supabase local (npm run db:iniciar),
# iguais em qualquer máquina e sem valor fora dela. Em produção, use a URL e a chave
# pública do projeto na nuvem. Nunca coloque aqui a chave de serviço.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_CHAVE=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# "1" mostra o botão "Entrar com Google" (precisa do provedor configurado no Supabase).
LOGIN_GOOGLE=0
